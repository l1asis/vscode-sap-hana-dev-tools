COLUMN TABLE "com.mycompany.apps::sample_table" (
    "ID" INTEGER CS_INT NOT NULL,
    "NAME" NVARCHAR(100) NOT NULL,
    "DESCRIPTION" NCLOB,
    "PRICE" DECIMAL(15, 2),
    "CREATED_AT" TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    "IS_ACTIVE" BOOLEAN DEFAULT TRUE,
    PRIMARY KEY ("ID")
) 
COMMENT 'Test-Tabelle für Syntax-Highlighting'
UNLOAD PRIORITY 5 
AUTO MERGE;
