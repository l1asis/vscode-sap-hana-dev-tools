PROCEDURE "MYSCHEMA"."acme.com.app1::GET_DATA" (IN iv_id INTEGER, OUT et_result TABLE (id INTEGER))
LANGUAGE SQLSCRIPT SQL SECURITY INVOKER READS SQL DATA AS
BEGIN
    DECLARE EXIT HANDLER FOR SQLEXCEPTION SELECT ::SQL_ERROR_CODE, ::SQL_ERROR_MESSAGE FROM DUMMY;
    et_result = CE_PROJECTION(:lt, ["ID"]);
    et_result = MAP_MERGE(:lt, fn(:lt.id));
END
