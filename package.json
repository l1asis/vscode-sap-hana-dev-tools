{
  "name": "sap-hana-sql",
  "displayName": "SAP HANA SQL & XS Classic",
  "description": "SAP HANA SQL / SQLScript, XS Classic (.hdbtable, .hdbdd, .xsjs, ...) and HDI / XS Advanced artifacts (.hdbcds, .hdbgrants, .hdbtabledata, ...): syntax highlighting plus a configurable SQL formatter",
  "version": "0.1.0",
  "publisher": "l1asis",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
