{
  "name": "SAP HANA HDBView (XS Classic)",
  "scopeName": "source.hdbview",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#query"
    },
    {
      "include": "#assignment"
    },
    {
      "include": "source.hanasql"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.hdbview",
          "match": "\\/\\/.*$"
        },
        {
          "name": "comment.block.hdbview",
          "begin": "\\/\\*",
          "end": "\\*\\/"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.hdbview",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.hdbview",
          "match": "\\\\."
        }
      ]
    },
    "number": {
      "name": "constant.numeric.hdbview",
      "match": "(?<![\\w.])-?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b"
    },
    "boolean": {
      "name": "constant.language.boolean.hdbview",
      "match": "\\b(?:true|false)\\b"
    },
    "values": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#string"
        },
        {
          "include": "#number"
        },
        {
          "include": "#boolean"
        },
        {
          "name": "constant.other.enum.hdbview",
          "match": "\\b[A-Za-z_][\\w]*\\b"
        },
        {
          "name": "punctuation.separator.comma.hdbview",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.hdbview",
          "match": ":"
        },
        {
          "name": "punctuation.section.brackets.hdbview",
          "match": "[\\[\\]]"
        }
      ]
    },
    "embedded-sql": {
      "patterns": [
        {
          "include": "#embedded-sql-comments"
        },
        {
          "include": "#embedded-sql-quoted-identifier"
        },
        {
          "name": "constant.character.escape.hdbview",
          "match": "\\\\."
        },
        {
          "include": "source.hanasql#strings"
        },
        {
          "include": "source.hanasql#statements"
        },
        {
          "include": "source.hanasql#clause-phrases"
        },
        {
          "include": "#embedded-sql-hierarchy-call"
        },
        {
          "include": "source.hanasql#numbers"
        },
        {
          "include": "source.hanasql#sqlscript-variables"
        },
        {
          "include": "source.hanasql#functions"
        },
        {
          "include": "source.hanasql#sqlscript-builtins"
        },
        {
          "include": "source.hanasql#types"
        },
        {
          "include": "source.hanasql#constants"
        },
        {
          "include": "source.hanasql#logical-operators"
        },
        {
          "include": "source.hanasql#keywords"
        },
        {
          "include": "source.hanasql#operators"
        }
      ]
    },
    "embedded-sql-comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.hanasql",
          "match": "--(?:[^\"\\\\]|\\\\.)*"
        },
        {
          "name": "comment.block.hanasql",
          "begin": "\\/\\*",
          "end": "\\*/|(?=\")"
        }
      ]
    },
    "embedded-sql-quoted-identifier": {
      "name": "variable.other.quoted-identifier.hanasql",
      "begin": "\\\\\"",
      "end": "\\\\\"|(?=\")"
    },
    "embedded-sql-hierarchy-call": {
      "begin": "(?i)(?:\\b|(?<=\\\\[nrt]))(HIERARCHY_ANCESTORS_AGGREGATE|HIERARCHY_ANCESTORS|HIERARCHY_DESCENDANTS_AGGREGATE|HIERARCHY_DESCENDANTS|HIERARCHY_LEVELED|HIERARCHY_SIBLINGS|HIERARCHY_SPANTREE|HIERARCHY_TEMPORAL|HIERARCHY)\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "support.function.hanasql"
        }
      },
      "end": "\\)|(?=\")",
      "patterns": [
        {
          "include": "#embedded-sql-parens"
        },
        {
          "include": "#embedded-sql-comments"
        },
        {
          "include": "#embedded-sql-quoted-identifier"
        },
        {
          "include": "source.hanasql#statements"
        },
        {
          "include": "source.hanasql#clause-phrases"
        },
        {
          "include": "source.hanasql#hierarchy-keywords"
        },
        {
          "include": "#embedded-sql"
        }
      ]
    },
    "embedded-sql-parens": {
      "begin": "\\(",
      "end": "\\)|(?=\")",
      "patterns": [
        {
          "include": "#embedded-sql-parens"
        },
        {
          "include": "#embedded-sql"
        }
      ]
    },
    "query": {
      "begin": "\\b(query)\\b\\s*(=)\\s*(\")",
      "beginCaptures": {
        "1": {
          "name": "support.type.property-name.hdbview"
        },
        "2": {
          "name": "keyword.operator.assignment.hdbview"
        },
        "3": {
          "name": "punctuation.definition.string.begin.hdbview"
        }
      },
      "end": "(\")",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.hdbview"
        }
      },
      "contentName": "meta.embedded.block.sql.hdbview",
      "patterns": [
        {
          "include": "#embedded-sql"
        }
      ]
    },
    "assignment": {
      "begin": "\\b(schema|public|depends_on|depends_on_table|depends_on_view)\\b\\s*(=)",
      "beginCaptures": {
        "1": {
          "name": "support.type.property-name.hdbview"
        },
        "2": {
          "name": "keyword.operator.assignment.hdbview"
        }
      },
      "end": "(;)|(?=^\\s*[A-Za-z_]\\w*\\s*=)",
      "endCaptures": {
        "1": {
          "name": "punctuation.terminator.statement.hdbview"
        }
      },
      "patterns": [
        {
          "include": "#values"
        }
      ]
    }
  }
}
