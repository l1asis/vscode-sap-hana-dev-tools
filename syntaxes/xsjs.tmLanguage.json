{
  "name": "SAP HANA XS JavaScript (.xsjs, .xsjslib)",
  "scopeName": "source.xsjs",
  "patterns": [
    {
      "include": "#xs-api"
    },
    {
      "include": "source.js"
    }
  ],
  "repository": {
    "xs-api": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_$])(\\$)(\\.)(import|require)\\b",
          "captures": {
            "1": {
              "name": "variable.language.xsjs"
            },
            "2": {
              "name": "punctuation.accessor.xsjs"
            },
            "3": {
              "name": "support.function.import.xsjs"
            }
          }
        },
        {
          "begin": "(?<![A-Za-z0-9_$])(\\$)(\\.)(application|request|response|db|hdb|net|util|web|session|security|jobs|trace|text|repo|config|process)\\b",
          "beginCaptures": {
            "1": {
              "name": "variable.language.xsjs"
            },
            "2": {
              "name": "punctuation.accessor.xsjs"
            },
            "3": {
              "name": "support.class.api.xsjs"
            }
          },
          "end": "(?!\\s*\\.[A-Za-z_])",
          "patterns": [
            {
              "match": "(\\.)([A-Z][A-Z0-9_]+)\\b(?!\\s*\\()",
              "captures": {
                "1": {
                  "name": "punctuation.accessor.xsjs"
                },
                "2": {
                  "name": "support.constant.xsjs"
                }
              }
            },
            {
              "match": "(\\.)([A-Z][A-Za-z0-9_]*)\\b",
              "captures": {
                "1": {
                  "name": "punctuation.accessor.xsjs"
                },
                "2": {
                  "name": "support.class.xsjs"
                }
              }
            },
            {
              "match": "(\\.)([A-Za-z_]\\w*)(?=\\s*\\()",
              "captures": {
                "1": {
                  "name": "punctuation.accessor.xsjs"
                },
                "2": {
                  "name": "support.function.xsjs"
                }
              }
            },
            {
              "match": "(\\.)([A-Za-z_]\\w*)\\b",
              "captures": {
                "1": {
                  "name": "punctuation.accessor.xsjs"
                },
                "2": {
                  "name": "support.variable.property.xsjs"
                }
              }
            }
          ]
        }
      ]
    }
  }
}
