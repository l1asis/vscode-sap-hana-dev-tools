{
  "name": "SAP HANA XS JavaScript (.xsjs, .xsjslib)",
  "scopeName": "source.xsjs",
  "patterns": [
    {
      "include": "#xs-api"
    },
    {
      "include": "source.js"
    }
  ],
  "repository": {
    "xs-api": {
      "patterns": [
        {
          "match": "(\\$)(\\.)(import|require)\\b",
          "captures": {
            "1": {
              "name": "variable.language.xsjs"
            },
            "2": {
              "name": "punctuation.accessor.xsjs"
            },
            "3": {
              "name": "support.function.import.xsjs"
            }
          }
        },
        {
          "match": "(\\$)(\\.)(application|request|response|db|hdb|net|util|web|session|security|jobs|trace|text|repo|process)((?:\\.[A-Za-z_]\\w*)*)(\\.)([A-Z][A-Z0-9_]+)\\b",
          "captures": {
            "1": {
              "name": "variable.language.xsjs"
            },
            "2": {
              "name": "punctuation.accessor.xsjs"
            },
            "3": {
              "name": "support.class.api.xsjs"
            },
            "4": {
              "name": "support.class.xsjs"
            },
            "5": {
              "name": "punctuation.accessor.xsjs"
            },
            "6": {
              "name": "support.constant.xsjs"
            }
          }
        },
        {
          "match": "(\\$)(\\.)(application|request|response|db|hdb|net|util|web|session|security|jobs|trace|text|repo|process)\\b",
          "captures": {
            "1": {
              "name": "variable.language.xsjs"
            },
            "2": {
              "name": "punctuation.accessor.xsjs"
            },
            "3": {
              "name": "support.class.api.xsjs"
            }
          }
        }
      ]
    }
  }
}
