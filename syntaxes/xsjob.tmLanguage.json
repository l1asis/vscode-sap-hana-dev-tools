{
  "name": "SAP HANA XS Job (.xsjob)",
  "scopeName": "source.xsjob",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "begin": "(\"xscron\")(\\s*:\\s*)(\")",
      "beginCaptures": {
        "1": {
          "name": "support.type.property-name.json.xsjob"
        },
        "2": {
          "name": "punctuation.separator.key-value.xsjob"
        },
        "3": {
          "name": "punctuation.definition.string.begin.xsjob"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.xsjob"
        }
      },
      "contentName": "string.quoted.double.xscron.xsjob",
      "patterns": [
        {
          "name": "keyword.operator.wildcard.xsjob",
          "match": "\\*(?:\\/\\d+)?"
        },
        {
          "name": "constant.language.weekday.xsjob",
          "match": "(?:-?\\d\\.)?\\b(?:mon|tue|wed|thu|fri|sat|sun)\\b"
        },
        {
          "name": "constant.numeric.xsjob",
          "match": "-?\\d+(?::-?\\d+)?(?:\\/\\d+)?"
        },
        {
          "name": "punctuation.separator.comma.xsjob",
          "match": ","
        }
      ]
    },
    {
      "name": "support.type.property-name.json.xsjob",
      "match": "\"(?:description|action|schedules|xscron|parameter|signature_version)\"(?=\\s*:)"
    },
    {
      "name": "support.type.property-name.json",
      "match": "\"(?:[^\"\\\\]|\\\\.)*\"(?=\\s*:)"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "name": "constant.language.json.xsjob",
      "match": "\\b(?:true|false|null)\\b"
    },
    {
      "name": "punctuation.separator.key-value.xsjob",
      "match": ":"
    },
    {
      "name": "punctuation.separator.comma.xsjob",
      "match": ","
    },
    {
      "name": "punctuation.section.braces.xsjob",
      "match": "[{}]"
    },
    {
      "name": "punctuation.section.brackets.xsjob",
      "match": "[\\[\\]]"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.xsjob",
          "match": "\\/\\/.*$"
        },
        {
          "name": "comment.block.xsjob",
          "begin": "\\/\\*",
          "end": "\\*\\/"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.xsjob",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.xsjob",
          "match": "\\\\."
        }
      ]
    },
    "number": {
      "name": "constant.numeric.xsjob",
      "match": "(?<![\\w.])-?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b"
    }
  }
}
