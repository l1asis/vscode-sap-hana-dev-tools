{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SAP HANA SQL",
  "scopeName": "source.hanasql",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#quoted-identifiers"
    },
    {
      "include": "#entity-definitions"
    },
    {
      "include": "#statements"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#sqlscript-variables"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#sqlscript-builtins"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#logical-operators"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.hanasql",
          "match": "--.*$"
        },
        {
          "name": "comment.block.hanasql",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.single.hanasql",
      "begin": "(?i)(?:\\b[NX])?'",
      "end": "'(?!')",
      "patterns": [
        {
          "name": "constant.character.escape.hanasql",
          "match": "''"
        }
      ]
    },
    "quoted-identifiers": {
      "name": "variable.other.quoted-identifier.hanasql",
      "match": "\"(?:[^\"]|\"\")*\""
    },
    "entity-definitions": {
      "patterns": [
        {
          "comment": "CREATE [OR REPLACE] <object> <name>",
          "match": "(?i)\\b(CREATE(?:\\s+OR\\s+REPLACE)?)\\s+((?:(?:COLUMN|ROW|GLOBAL\\s+TEMPORARY|LOCAL\\s+TEMPORARY|TEMPORARY|VIRTUAL|PUBLIC|UNIQUE|HISTORY|COLLECTION)\\s+)*(?:TABLE|VIEW|PROCEDURE|FUNCTION|SCHEMA|SEQUENCE|SYNONYM|TRIGGER|TYPE|INDEX|ROLE|USER|PROJECTION\\s+VIEW|FULLTEXT\\s+INDEX))\\s+(?:IF\\s+NOT\\s+EXISTS\\s+)?(\"(?:[^\"]|\"\")+\"(?:\\.\"(?:[^\"]|\"\")+\")?|[A-Za-z_#$][\\w#$]*(?:\\.[A-Za-z_#$][\\w#$]*)?)",
          "captures": {
            "1": {
              "name": "keyword.control.ddl.hanasql"
            },
            "2": {
              "name": "keyword.control.ddl.hanasql"
            },
            "3": {
              "name": "entity.name.type.hanasql"
            }
          }
        },
        {
          "comment": "HDI design-time artifacts (no CREATE): PROCEDURE \"name\", COLUMN TABLE \"name\", STRUCTURED PRIVILEGE \"name\", RESULT CACHE \"name\", ...",
          "match": "(?i)^\\s*((?:COLUMN|ROW)\\s+TABLE|TABLE\\s+TYPE|VIRTUAL\\s+(?:TABLE|FUNCTION|PROCEDURE)|APPLICATION\\s+TIME|GRAPH\\s+WORKSPACE|PROJECTION\\s+VIEW|STRUCTURED\\s+(?:PRIVILEGE|FILTER)|RESULT\\s+CACHE|SYSTEM\\s+VERSIONING|SCHEDULER\\s+JOB|REMOTE\\s+TABLE\\s+REPLICA|(?:FUZZY\\s+SEARCH|FULLTEXT|UNIQUE|HASH|BLOCK\\s+RANGE|ADJACENCY|INVERTED\\s+(?:HASH|VALUE))\\s+INDEX|INDEX|COLLECTION|LIBRARY|STATISTICS|SEQUENCE|TRIGGER|PROCEDURE|FUNCTION|VIEW|TABLE)\\s+(\\\"(?:[^\\\"]|\\\"\\\")+\\\"(?:\\.\\\"(?:[^\\\"]|\\\"\\\")+\\\")?|[A-Za-z_#$][\\w#$]*(?:\\.[A-Za-z_#$][\\w#$]*)?)",
          "captures": {
            "1": {
              "name": "keyword.control.ddl.hanasql"
            },
            "2": {
              "name": "entity.name.type.hanasql"
            }
          }
        },
        {
          "comment": "HDI headerless Fabric Virtual Table: SHARED [SNAPSHOT] REPLICA [PAGE|COLUMN LOADABLE] ON \"VT\"",
          "match": "(?i)^\\s*(SHARED(?:\\s+SNAPSHOT)?\\s+REPLICA(?:\\s+(?:PAGE|COLUMN)\\s+LOADABLE)?\\s+ON)\\s+(\"(?:[^\"]|\"\")+\"(?:\\.\"(?:[^\"]|\"\")+\")?|[A-Za-z_#$][\\w#$]*(?:\\.[A-Za-z_#$][\\w#$]*)?)",
          "captures": {
            "1": {
              "name": "keyword.control.ddl.hanasql"
            },
            "2": {
              "name": "entity.name.type.hanasql"
            }
          }
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.hanasql",
      "match": "\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b|\\.\\d+(?:[eE][+-]?\\d+)?\\b"
    },
    "sqlscript-variables": {
      "patterns": [
        {
          "name": "support.variable.system.hanasql",
          "match": "(?i)::[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "variable.other.readwrite.hanasql",
          "match": "(?<![:\\w]):[A-Za-z_#$][\\w#$]*"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.aggregate.hanasql",
          "match": "(?i)\\b(?:AUTO_CORR|AVG|CORR|CORR_SPEARMAN|COUNT|CROSS_CORR|DFT|FIRST_VALUE|LAST_VALUE|MAX|MEDIAN|MIN|NTH_VALUE|STDDEV|STDDEV_POP|STDDEV_SAMP|STRING_AGG|SUM|VAR|VAR_POP|VAR_SAMP|ARRAY_AGG)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.window.hanasql",
          "match": "(?i)\\b(?:BINNING|CROSS_ENCODE|CUBIC_SPLINE_APPROX|CUME_DIST|DENSE_RANK|LAG|LEAD|LINEAR_APPROX|NTILE|PERCENT_RANK|PERCENTILE_CONT|PERCENTILE_DISC|RANDOM_PARTITION|RANK|ROW_NUMBER|SERIES_FILTER|WEIGHTED_AVG)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.string.hanasql",
          "match": "(?i)\\b(?:ABAP_ALPHANUM|ABAP_DF16RAW_TO_SMALLDECIMAL|ABAP_DF34RAW_TO_DECIMAL|ABAP_LOWER|ABAP_NUMC|ABAP_UPPER|ASCII|BINTOHEX|BINTONHEX|BINTOSTR|CHAR|CHR|CONCAT|CONCAT_NAZ|HAMMING_DISTANCE|HEXTOBIN|HEXTONUM|INITCAP|LCASE|LEFT|LENGTH|LOCATE|LOCATE_REGEXPR|LOWER|LPAD|LTRIM|NCHAR|NORMALIZE|NUMTOHEX|OCCURRENCES_REGEXPR|REPLACE|REPLACE_REGEXPR|RIGHT|RPAD|RTRIM|SOUNDEX|STRTOBIN|SUBSTR|SUBSTR_AFTER|SUBSTR_BEFORE|SUBSTRING|SUBSTRING_REGEXPR|TRIM|UCASE|UNICODE|UPPER|XMLTABLE)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.numeric.hanasql",
          "match": "(?i)\\b(?:ABS|ACOS|ASIN|ATAN|ATAN2|BITAND|BITAT|BITCOUNT|BITNOT|BITOR|BITSET|BITUNSET|BITXOR|CEIL|COS|COSH|COT|EXP|FLOOR|LN|LOG|MOD|NDIV0|POWER|RAND|RAND_SECURE|ROUND|SIGN|SIN|SINH|SQRT|TAN|TANH|UMINUS)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.datetime.hanasql",
          "match": "(?i)\\b(?:ADD_DAYS|ADD_MONTHS|ADD_MONTHS_LAST|ADD_NANO100|ADD_SECONDS|ADD_WORKDAYS|ADD_YEARS|CURRENT_DATE|CURRENT_MVCC_SNAPSHOT_TIMESTAMP|CURRENT_TIME|CURRENT_TIMESTAMP|CURRENT_UTCDATE|CURRENT_UTCTIME|CURRENT_UTCTIMESTAMP|DAYNAME|DAYOFMONTH|DAYOFYEAR|DAYS_BETWEEN|EXTRACT|HOUR|ISOWEEK|LAST_DAY|LOCALTOUTC|MINUTE|MONTH|MONTHNAME|MONTHS_BETWEEN|NANO100_BETWEEN|NEXT_DAY|NOW|QUARTER|SECOND|SECONDS_BETWEEN|UTCTOLOCAL|WEEK|WEEKDAY|WORKDAYS_BETWEEN|YEAR|YEARS_BETWEEN)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.conversion.hanasql",
          "match": "(?i)\\b(?:CAST|TO_ALPHANUM|TO_BIGINT|TO_BINARY|TO_BLOB|TO_BOOLEAN|TO_CHAR|TO_CLOB|TO_DATE|TO_DATS|TO_DECIMAL|TO_DOUBLE|TO_FIXEDCHAR|TO_INT|TO_INTEGER|TO_JSON_BOOLEAN|TO_NCHAR|TO_NCLOB|TO_NVARCHAR|TO_REAL|TO_SECONDDATE|TO_SMALLDECIMAL|TO_SMALLINT|TO_TIME|TO_TIMESTAMP|TO_TIMS|TO_TINYINT|TO_VARCHAR)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.hanasql",
          "match": "(?i)\\b(?:CARDINALITY|MEMBER_AT|SUBARRAY|TRIM_ARRAY|ARRAY|UNNEST|GROUP_SCORE|INDEXING_ERROR_CODE|INDEXING_ERROR_MESSAGE|INDEXING_STATUS|LANGUAGE|MIMETYPE|PLAINTEXT|SCORE|HIERARCHY|HIERARCHY_LEVELED|HIERARCHY_SPANTREE|HIERARCHY_TEMPORAL|HIERARCHY_ANCESTORS|HIERARCHY_ANCESTORS_AGGREGATE|HIERARCHY_DESCENDANTS|HIERARCHY_DESCENDANTS_AGGREGATE|HIERARCHY_SIBLINGS|HIERARCHY_COMPOSITE_ID|JSON_QUERY|JSON_TABLE|JSON_VALUE|ALLOW_PRECISION_LOSS|COALESCE|CONVERT_CURRENCY|CONVERT_UNIT|CURRENT_CONNECTION|CURRENT_IDENTITY_VALUE|CURRENT_OBJECT_SCHEMA|CURRENT_SCHEMA|CURRENT_SITE_ID|CURRENT_TRANSACTION_ISOLATION_LEVEL|CURRENT_UPDATE_STATEMENT_SEQUENCE|CURRENT_UPDATE_TRANSACTION|CURRENT_USER|CURRENT_USER_ID|EXPRESSION_MACRO|GREATEST|GROUPING|GROUPING_ID|HASH_MD5|HASH_SHA256|IFNULL|LEAST|MAP|NEWUID|NULLIF|RECORD_COMMIT_TIMESTAMP|RECORD_ID|RESULT_CACHE_ID|RESULT_CACHE_REFRESH_TIME|SESSION_CONTEXT|SESSION_USER|SYSUUID|WIDTH_BUCKET|XMLEXTRACT|XMLEXTRACTVALUE|ENCRYPTION_ROOT_KEYS_EXTRACT_KEYS|ENCRYPTION_ROOT_KEYS_HAS_BACKUP_PASSWORD|ESCAPE_DOUBLE_QUOTES|ESCAPE_SINGLE_QUOTES|GENERATE_PASSWORD|IS_SQL_INJECTION_SAFE|VALIDATE_USERGROUP_CONNECT_RESTRICTION_DETAILS|VALIDATE_USERGROUP_CONNECT_RESTRICTION|SERIES_DISAGGREGATE|SERIES_DISAGGREGATE_BIGINT|SERIES_DISAGGREGATE_DATE|SERIES_DISAGGREGATE_DECIMAL|SERIES_DISAGGREGATE_INTEGER|SERIES_DISAGGREGATE_SECONDDATE|SERIES_DISAGGREGATE_SMALLINT|SERIES_DISAGGREGATE_TIME|SERIES_DISAGGREGATE_TIMESTAMP|SERIES_DISAGGREGATE_TINYINT|SERIES_ELEMENT_TO_PERIOD|SERIES_GENERATE|SERIES_GENERATE_BIGINT|SERIES_GENERATE_DATE|SERIES_GENERATE_DECIMAL|SERIES_GENERATE_INTEGER|SERIES_GENERATE_SECONDDATE|SERIES_GENERATE_SMALLINT|SERIES_GENERATE_TIME|SERIES_GENERATE_TIMESTAMP|SERIES_GENERATE_TINYINT|SERIES_PERIOD_TO_ELEMENT|SERIES_ROUND|GET_NUM_SERVERS)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.hanasql",
          "match": "(?i)\\b(?:SUBSTR_REGEXPR|AI_TEXT_COMPLETION|ANALYZE_SQLSCRIPT_DEFINITION|ANALYZE_SQLSCRIPT_OBJECTS|COSINE_SIMILARITY|CREATE_VECTOR_EMBEDDINGS|CURRENT_DATABASE|CURRENT_ROLEGROUP|CURRENT_USERGROUP|GET_DELTA_LAKE_TABLE_CHANGES|GET_DELTA_LAKE_TABLE_VERSION|GET_REMOTE_SOURCE_AI_MODELS|GET_X509_USER_MAPPING_DETAILS|L2DISTANCE|L2NORM|L2NORMALIZE|OPENCYPHER_TABLE|PARSE_CERTIFICATES|PARSE_JSON|PARTITION_ALLOCATION|PARTITION_HASH|RDF_GRAPH_FROM_GRAPH_WORKSPACE|RDF_GRAPH_TO_GRAPH_WORKSPACE|RECORD_LOCK_STATE|ROW_LOCK_WAIT_STATISTICS|SPARQL_EXECUTE|SPARQL_TABLE|SQL_TABLE|SQLSCRIPT_RUN_TESTS_ON_ORIGINAL_DATA|STATEMENT_EXECUTION_HOST|STATEMENT_EXECUTION_PORT|SUBVECTOR|TM_CATEGORIZE_KNN|TM_GET_RELATED_DOCUMENTS|TM_GET_RELATED_TERMS|TM_GET_RELEVANT_DOCUMENTS|TM_GET_RELEVANT_TERMS|TM_GET_SUGGESTED_TERMS|TO_ARRAY|TO_HALF_VECTOR|TO_REAL_VECTOR|TO_VARBINARY|VECTOR_EMBEDDING)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.spatial.hanasql",
          "match": "(?i)\\b(?:ST_ADDPOINT|ST_ALLOCATEDSIZE|ST_ALPHASHAPE|ST_ALPHASHAPEAGGR|ST_ALPHASHAPEAREA|ST_ALPHASHAPEAREAAGGR|ST_ALPHASHAPEEDGE|ST_AREA|ST_ASBINARY|ST_ASESRIJSON|ST_ASESRISHAPE|ST_ASEWKB|ST_ASEWKT|ST_ASGEOJSON|ST_ASMVT|ST_ASMVTGEOM|ST_ASSVG|ST_ASSVGAGGR|ST_ASTEXT|ST_ASWKB|ST_ASWKT|ST_BOUNDARY|ST_BUFFER|ST_CENTROID|ST_CLOSESTPOINT|ST_CLUSTERCELL|ST_CLUSTERCENTROID|ST_CLUSTERENVELOPE|ST_CLUSTERID|ST_COLLECT|ST_COLLECTAGGR|ST_CONCAVEHULL|ST_CONCAVEHULLAGGR|ST_CONTAINS|ST_CONVEXHULL|ST_CONVEXHULLAGGR|ST_COORDDIM|ST_COVEREDBY|ST_COVERS|ST_CROSSES|ST_CURVETOLINE|ST_DIFFERENCE|ST_DIMENSION|ST_DISJOINT|ST_DISTANCE|ST_DUPLICATES|ST_ENDPOINT|ST_ENVELOPE|ST_ENVELOPEAGGR|ST_EQUALS|ST_EXTERIORRING|ST_FLIPCOORDINATES|ST_FORCE2D|ST_FORCE3DM|ST_FORCE3DZ|ST_FORCE4D|ST_FRECHETDISTANCE|ST_GENERATEPOINTS|ST_GEOHASH|ST_GEOHASHBOUNDARY|ST_GEOHASHNEIGHBORS|ST_GEOMFROMESRISHAPE|ST_GEOMFROMEWKB|ST_GEOMFROMEWKT|ST_GEOMFROMGEOJSON|ST_GEOMFROMTEXT|ST_GEOMFROMWKB|ST_GEOMFROMWKT|ST_GEOMETRYN|ST_GEOMETRYTYPE|ST_HAUSDORFFDISTANCE|ST_HEXAGONGRID|ST_HEXAGONGRIDBOUNDINGBOX|ST_INTERIORRINGN|ST_INTERPOLATEPOINT|ST_INTERSECTION|ST_INTERSECTIONAGGR|ST_INTERSECTS|ST_INTERSECTSFILTER|ST_INTERSECTSRECT|ST_INTERSECTSRECTPLANAR|ST_IS3D|ST_ISCLOSED|ST_ISEMPTY|ST_ISMEASURED|ST_ISRING|ST_ISSIMPLE|ST_ISVALID|ST_LENGTH|ST_LINEHASH|ST_LINEINTERPOLATEPOINT|ST_LINELOCATEPOINT|ST_LINEMERGE|ST_LINESUBSTRING|ST_LOCATEALONG|ST_LOCATEBETWEEN|ST_M|ST_MAKEENVELOPE|ST_MAKELINE|ST_MAKELINEAGGR|ST_MAKEPOLYGON|ST_MAKEVALID|ST_MINIMUMBOUNDINGCIRCLE|ST_MMAX|ST_MMIN|ST_NUMGEOMETRIES|ST_NUMINTERIORRING|ST_NUMINTERIORRINGS|ST_NUMPATCHES|ST_NUMPOINTS|ST_ORDERINGEQUALS|ST_OVERLAPS|ST_PATCHN|ST_PERIMETER|ST_POINTN|ST_POINTONSURFACE|ST_RECTANGLEGRID|ST_RECTANGLEGRIDBOUNDINGBOX|ST_RELATE|ST_REMOVEPOINT|ST_REVERSE|ST_ROTATE|ST_SCALE|ST_SETPOINT|ST_SETSRID|ST_SHORTESTLINE|ST_SIMPLIFY|ST_SNAPTOGRID|ST_SPLIT|ST_SQUAREGRID|ST_SRID|ST_STARTPOINT|ST_SUBDIVIDE|ST_SYMDIFFERENCE|ST_TOUCHES|ST_TRANSFORM|ST_TRANSLATE|ST_TRANSLATE3D|ST_UNION|ST_UNIONAGGR|ST_VORONOICELL|ST_VORONOICELLAGGR|ST_WITHIN|ST_WITHINDISTANCE|ST_X|ST_XMAX|ST_XMIN|ST_Y|ST_YMAX|ST_YMIN|ST_Z|ST_ZMAX|ST_ZMIN)\\b(?=\\s*\\()"
        }
      ]
    },
    "types": {
      "name": "storage.type.hanasql",
      "match": "(?i)\\b(?:TINYINT|SMALLINT|INTEGER|INT|BIGINT|DECIMAL|DEC|SMALLDECIMAL|REAL|DOUBLE|FLOAT|BOOLEAN|VARCHAR|NVARCHAR|ALPHANUM|SHORTTEXT|VARBINARY|BLOB|CLOB|NCLOB|TEXT|BINTEXT|DATE|TIME|SECONDDATE|TIMESTAMP|DAYDATE|LONGDATE|CHAR|NCHAR|ARRAY|JSON|REAL_VECTOR|HALF_VECTOR|ST_POINT|ST_POINTZ|ST_POINTM|ST_POINTZM|ST_GEOMETRY|ST_CIRCULARSTRING|ST_GEOMETRYCOLLECTION|ST_LINESTRING|ST_MULTILINESTRING|ST_MULTIPOINT|ST_MULTIPOLYGON|ST_POLYGON|SQLSCRIPT_STATEMENT_STATISTICS_TYPE|SQLSCRIPT_LOGGING_TABLE_TYPE)\\b"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.hanasql",
          "match": "(?i)\\b(?:TRUE|FALSE|NULL|UNKNOWN)\\b"
        },
        {
          "name": "support.constant.hanasql",
          "match": "(?i)\\b(?:CURRENT_(?:CONNECTION|DATE|SCHEMA|TIME|TIMESTAMP|TRANSACTION_ISOLATION_LEVEL|USER|UTCDATE|UTCTIME|UTCTIMESTAMP)|SESSION_USER|SYSUUID|UTCTIMESTAMP|SQLSCRIPT)\\b"
        }
      ]
    },
    "logical-operators": {
      "name": "keyword.operator.logical.hanasql",
      "match": "(?i)\\b(?:AND|OR|NOT|IN|IS|LIKE|LIKE_REGEXPR|BETWEEN|EXISTS|ANY|SOME|CONTAINS)\\b"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.hanasql",
          "match": "(?i)\\b(?:BEGIN|END|IF|ELSE|ELSEIF|THEN|CASE|WHEN|WHILE|FOR|FOREACH|LOOP|RETURN|RETURNS|EXIT|BREAK|CONTINUE|HANDLER|SIGNAL|RESIGNAL|EXCEPTION|CONDITION|DECLARE|OPEN|CLOSE|FETCH|CURSOR|CALL|DO|EXEC|EXECUTE|AUTONOMOUS|TRANSACTION)\\b"
        },
        {
          "name": "keyword.other.dml.hanasql",
          "match": "(?i)\\b(?:OCCURRENCE|SELECT|FROM|WHERE|GROUP|HAVING|ORDER|BY|LIMIT|OFFSET|TOP|DISTINCT|ALL|AS|INTO|VALUES|INSERT|UPDATE|UPSERT|REPLACE|DELETE|MERGE|TRUNCATE|LOAD|UNLOAD|EXPLAIN|JOIN|INNER|LEFT|RIGHT|FULL|OUTER|CROSS|NATURAL|LATERAL|ON|USING|UNION|INTERSECT|EXCEPT|MINUS|WITH|OVER|PARTITION|WINDOW|ROLLUP|CUBE|TABLESAMPLE|ASC|DESC|PRIOR|START|CONNECT|NEXTVAL|CURRVAL|ROWID|SET|UNSET|BOTH|LEADING|TRAILING|REVERSE|COMMIT|ROLLBACK|SAVEPOINT)\\b"
        },
        {
          "name": "keyword.other.ddl.hanasql",
          "match": "(?i)\\b(?:CREATE|ALTER|DROP|RENAME|GRANT|REVOKE|COMMENT|ANNOTATE|REFRESH|TABLE|VIEW|COLUMN|ROW|PROCEDURE|FUNCTION|SCHEMA|SEQUENCE|SYNONYM|TRIGGER|TYPE|INDEX|ROLE|USER|PRIMARY|FOREIGN|KEY|REFERENCES|UNIQUE|CHECK|CONSTRAINT|DEFAULT|ADD|CASCADE|BEFORE|TEMPORARY|GLOBAL|LOCAL|VIRTUAL|LANGUAGE|SQL|SECURITY|DEFINER|INVOKER|READS|MODIFIES|IN|OUT|INOUT|PARAMETERS|GENERATED|ALWAYS|IDENTITY|AUTO|MERGE|PRIORITY|NOWAIT)\\b"
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.hanasql",
      "match": "\\|\\||:=|=>|<>|!=|<=|>=|[-+*/%=<>]"
    },
    "sqlscript-builtins": {
      "patterns": [
        {
          "name": "keyword.control.directive.pragma.hanasql",
          "match": "(?i)#\\[(?:INLINE|NO_INLINE)\\]"
        },
        {
          "name": "storage.type.annotation.pragma.hanasql",
          "match": "(?i)@(?:AnalyzerSuppress|pushscope|popscope|Test|TestSetUp|TestTearDown|TestSetUpTest|TestTearDownTest|TestSetUpConfig|TestTearDownConfig|TestSetUpLibrary|TestTearDownLibrary|TestClassification)\\b"
        },
        {
          "match": "\\b([A-Za-z_][\\w]*)(:)([A-Za-z_][\\w]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "variable.other.library.hanasql"
            },
            "2": {
              "name": "punctuation.accessor.hanasql"
            },
            "3": {
              "name": "support.function.library-member.hanasql"
            }
          }
        },
        {
          "match": "\\b([A-Za-z_][\\w]*)(:)(LEVEL_(?:FATAL|ERROR|WARNING|INFO|DEBUG))\\b",
          "captures": {
            "1": {
              "name": "variable.other.library.hanasql"
            },
            "2": {
              "name": "punctuation.accessor.hanasql"
            },
            "3": {
              "name": "support.constant.library-member.hanasql"
            }
          }
        },
        {
          "name": "support.function.sqlscript.hanasql",
          "match": "(?i)\\b(?:CE_[A-Z_]+|MAP_MERGE|MAP_REDUCE|APPLY_FILTER|BIND_AS_PARAMETER|BIND_AS_VALUE|IS_REACHABLE|NEIGHBORS|SHORTEST_PATH|SHORTEST_PATHS_ONE_TO_ALL|K_SHORTEST_PATHS|STRONGLY_CONNECTED_COMPONENTS|INDUCED_SUBGRAPH|INVERSE_GRAPH|SUBGRAPH|VERTICES|EDGES|IN_DEGREE|OUT_DEGREE|DEGREE|IN_EDGES|OUT_EDGES|RECORD_COUNT|IS_EMPTY)\\b(?=\\s*\\()"
        },
        {
          "name": "support.class.library.hanasql",
          "match": "(?i)\\bSQLSCRIPT_[A-Z_]+\\b"
        },
        {
          "name": "support.variable.system.hanasql",
          "match": "(?i)\\b(?:SQL_ERROR_CODE|SQL_ERROR_MESSAGE|ROWCOUNT|CURRENT_LINE_NUMBER|CURRENT_OBJECT_NAME|CURRENT_OBJECT_SCHEMA)\\b"
        },
        {
          "name": "support.constant.hint.hanasql",
          "match": "(?i)\\b(?:NO_INLINE|INLINE|ROUTE_TO|VECTOR_INDEX|NO_VECTOR_INDEX)\\b"
        },
        {
          "name": "keyword.control.sqlscript.hanasql",
          "match": "(?i)\\b(?:SQLEXCEPTION|SQLWARNING|SEQUENTIAL|PARALLEL|EXECUTION|CONSTANT|DETERMINISTIC|LIBRARY|ENCRYPTION|TEST|PUBLIC|PRIVATE|TRAVERSE|BFS|DFS|VISIT|PRUNE)\\b"
        }
      ]
    },
    "statements": {
      "patterns": [
        {
          "name": "keyword.other.statement.hanasql",
          "match": "(?i)\\bALTER\\s+SYSTEM\\b(?:\\s+(?:ALTER|ADD|REMOVE|ENABLE|DISABLE|CLEAR|CREATE|LOAD|SAVE|START|STOP|RECLAIM|RECOMPILE|RECONFIGURE|REFRESH|RESET|APPLICATION|ENCRYPTION|AUDIT|LOG|CACHE|COLUMN|JOIN|DATA|STATISTICS|INIFILE|CONTENT|HISTORY|RESULT|SQL|PLAN|TIMEZONE|TRACES|PERFTRACE|LOB|SPACE|ENTRY|SERVICE|MONITORING|VIEW|SAVEPOINT|TABLE|PLACEMENT|CONFIGURATION|WAITGRAPH|RUNTIMEDUMP|KERNEL|PROFILER|ABSTRACT|CAPTURE|APPLY|ASYNCHRONOUS|CONSISTENCY|CHECK|ALL|THREADS|LOCATION|FILE|SECTIONS|TRACEPROFILE|PROFILE|SYSTEM))*"
        },
        {
          "name": "keyword.other.statement.hanasql",
