{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SAP HANA SQL",
  "scopeName": "source.hanasql",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#quoted-identifiers"
    },
    {
      "include": "#entity-definitions"
    },
    {
      "include": "#statements"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#sqlscript-variables"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#sqlscript-builtins"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#logical-operators"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.hanasql",
          "match": "--.*$"
        },
        {
          "name": "comment.block.hanasql",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.single.hanasql",
      "begin": "(?i)(?:\\b[NX])?'",
      "end": "'(?!')",
      "patterns": [
        {
          "name": "constant.character.escape.hanasql",
          "match": "''"
        }
      ]
    },
    "quoted-identifiers": {
      "name": "variable.other.quoted-identifier.hanasql",
      "match": "\"(?:[^\"]|\"\")*\""
    },
    "entity-definitions": {
      "patterns": [
        {
          "comment": "CREATE [OR REPLACE] <object> <name>",
          "match": "(?i)\\b(CREATE(?:\\s+OR\\s+REPLACE)?)\\s+((?:(?:COLUMN|ROW|GLOBAL\\s+TEMPORARY|LOCAL\\s+TEMPORARY|TEMPORARY|VIRTUAL|PUBLIC|UNIQUE|HISTORY|COLLECTION)\\s+)*(?:TABLE|VIEW|PROCEDURE|FUNCTION|SCHEMA|SEQUENCE|SYNONYM|TRIGGER|TYPE|INDEX|ROLE|USER|PROJECTION\\s+VIEW|FULLTEXT\\s+INDEX))\\s+(?:IF\\s+NOT\\s+EXISTS\\s+)?(\"(?:[^\"]|\"\")+\"(?:\\.\"(?:[^\"]|\"\")+\")?|[A-Za-z_#$][\\w#$]*(?:\\.[A-Za-z_#$][\\w#$]*)?)",
          "captures": {
            "1": {
              "name": "keyword.control.ddl.hanasql"
            },
            "2": {
              "name": "keyword.control.ddl.hanasql"
            },
            "3": {
              "name": "entity.name.type.hanasql"
            }
          }
        },
        {
          "comment": "HDI design-time artifacts (no CREATE): PROCEDURE \"name\", COLUMN TABLE \"name\", STRUCTURED PRIVILEGE \"name\", RESULT CACHE \"name\", ...",
          "match": "(?i)^\\s*((?:COLUMN|ROW)\\s+TABLE|TABLE\\s+TYPE|VIRTUAL\\s+(?:TABLE|FUNCTION|PROCEDURE)|APPLICATION\\s+TIME|GRAPH\\s+WORKSPACE|PROJECTION\\s+VIEW|STRUCTURED\\s+(?:PRIVILEGE|FILTER)|RESULT\\s+CACHE|SYSTEM\\s+VERSIONING|SCHEDULER\\s+JOB|REMOTE\\s+TABLE\\s+REPLICA|(?:FUZZY\\s+SEARCH|FULLTEXT|UNIQUE|HASH|BLOCK\\s+RANGE|ADJACENCY|INVERTED\\s+(?:HASH|VALUE))\\s+INDEX|INDEX|COLLECTION|LIBRARY|STATISTICS|SEQUENCE|TRIGGER|PROCEDURE|FUNCTION|VIEW|TABLE)\\s+(\\\"(?:[^\\\"]|\\\"\\\")+\\\"(?:\\.\\\"(?:[^\\\"]|\\\"\\\")+\\\")?|[A-Za-z_#$][\\w#$]*(?:\\.[A-Za-z_#$][\\w#$]*)?)",
          "captures": {
            "1": {
              "name": "keyword.control.ddl.hanasql"
            },
            "2": {
              "name": "entity.name.type.hanasql"
            }
          }
        },
        {
          "comment": "HDI headerless Fabric Virtual Table: SHARED [SNAPSHOT] REPLICA [PAGE|COLUMN LOADABLE] ON \"VT\"",
          "match": "(?i)^\\s*(SHARED(?:\\s+SNAPSHOT)?\\s+REPLICA(?:\\s+(?:PAGE|COLUMN)\\s+LOADABLE)?\\s+ON)\\s+(\"(?:[^\"]|\"\")+\"(?:\\.\"(?:[^\"]|\"\")+\")?|[A-Za-z_#$][\\w#$]*(?:\\.[A-Za-z_#$][\\w#$]*)?)",
          "captures": {
            "1": {
              "name": "keyword.control.ddl.hanasql"
            },
            "2": {
              "name": "entity.name.type.hanasql"
            }
          }
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.hanasql",
      "match": "\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b|\\.\\d+(?:[eE][+-]?\\d+)?\\b"
    },
    "sqlscript-variables": {
      "patterns": [
        {
          "name": "support.variable.system.hanasql",
          "match": "(?i)::[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "variable.other.readwrite.hanasql",
          "match": "(?<![:\\w]):[A-Za-z_#$][\\w#$]*"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.aggregate.hanasql",
          "match": "(?i)\\b(?:ARRAY_AGG|AUTO_CORR|AVG|CORR_SPEARMAN|CORR|COUNT|CROSS_CORR|DFT|FIRST_VALUE|LAST_VALUE|MAX|MEDIAN|MIN|NTH_VALUE|STDDEV_POP|STDDEV_SAMP|STDDEV|STRING_AGG|SUM|VAR_POP|VAR_SAMP|VAR)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.window.hanasql",
          "match": "(?i)\\b(?:BINNING|CROSS_ENCODE|CUBIC_SPLINE_APPROX|CUME_DIST|DENSE_RANK|LAG|LEAD|LINEAR_APPROX|NTILE|PERCENTILE_CONT|PERCENTILE_DISC|PERCENT_RANK|RANDOM_PARTITION|RANK|ROW_NUMBER|SERIES_FILTER|WEIGHTED_AVG)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.string.hanasql",
          "match": "(?i)\\b(?:ABAP_ALPHANUM|ABAP_DF16RAW_TO_SMALLDECIMAL|ABAP_DF34RAW_TO_DECIMAL|ABAP_LOWER|ABAP_NUMC|ABAP_UPPER|ASCII|BINTOHEX|BINTONHEX|BINTOSTR|CHAR|CHR|CONCAT_NAZ|CONCAT|HAMMING_DISTANCE|HEXTOBIN|HEXTONUM|INITCAP|LCASE|LEFT|LENGTH|LOCATE_REGEXPR|LOCATE|LOWER|LPAD|LTRIM|NCHAR|NORMALIZE|NUMTOHEX|OCCURRENCES_REGEXPR|REPLACE_REGEXPR|REPLACE|RIGHT|RPAD|RTRIM|SOUNDEX|STRTOBIN|SUBSTRING_REGEXPR|SUBSTRING|SUBSTR_AFTER|SUBSTR_BEFORE|SUBSTR|TRIM|UCASE|UNICODE|UPPER|XMLTABLE)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.numeric.hanasql",
          "match": "(?i)\\b(?:ABS|ACOS|ASIN|ATAN2|ATAN|BITAND|BITAT|BITCOUNT|BITNOT|BITOR|BITSET|BITUNSET|BITXOR|CEIL|COSH|COS|COT|EXP|FLOOR|LN|LOG|MOD|NDIV0|POWER|RAND_SECURE|RAND|ROUND|SIGN|SINH|SIN|SQRT|TANH|TAN|UMINUS)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.datetime.hanasql",
          "match": "(?i)\\b(?:ADD_DAYS|ADD_MONTHS_LAST|ADD_MONTHS|ADD_NANO100|ADD_SECONDS|ADD_WORKDAYS|ADD_YEARS|CURRENT_DATE|CURRENT_MVCC_SNAPSHOT_TIMESTAMP|CURRENT_TIMESTAMP|CURRENT_TIME|CURRENT_UTCDATE|CURRENT_UTCTIMESTAMP|CURRENT_UTCTIME|DAYNAME|DAYOFMONTH|DAYOFYEAR|DAYS_BETWEEN|EXTRACT|HOUR|ISOWEEK|LAST_DAY|LOCALTOUTC|MINUTE|MONTHNAME|MONTHS_BETWEEN|MONTH|NANO100_BETWEEN|NEXT_DAY|NOW|QUARTER|SECONDS_BETWEEN|SECOND|UTCTOLOCAL|WEEKDAY|WEEK|WORKDAYS_BETWEEN|YEARS_BETWEEN|YEAR)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.conversion.hanasql",
          "match": "(?i)\\b(?:CAST|TO_ALPHANUM|TO_BIGINT|TO_BINARY|TO_BLOB|TO_BOOLEAN|TO_CHAR|TO_CLOB|TO_DATE|TO_DATS|TO_DECIMAL|TO_DOUBLE|TO_FIXEDCHAR|TO_INTEGER|TO_INT|TO_JSON_BOOLEAN|TO_NCHAR|TO_NCLOB|TO_NVARCHAR|TO_REAL|TO_SECONDDATE|TO_SMALLDECIMAL|TO_SMALLINT|TO_TIMESTAMP|TO_TIME|TO_TIMS|TO_TINYINT|TO_VARCHAR)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.hanasql",
          "match": "(?i)\\b(?:AI_TEXT_COMPLETION|ALLOW_PRECISION_LOSS|ANALYZE_SQLSCRIPT_DEFINITION|ANALYZE_SQLSCRIPT_OBJECTS|ARRAY|CARDINALITY|COALESCE|CONVERT_CURRENCY|CONVERT_UNIT|COSINE_SIMILARITY|CREATE_VECTOR_EMBEDDINGS|CURRENT_CONNECTION|CURRENT_DATABASE|CURRENT_IDENTITY_VALUE|CURRENT_OBJECT_SCHEMA|CURRENT_ROLEGROUP|CURRENT_SCHEMA|CURRENT_SITE_ID|CURRENT_TRANSACTION_ISOLATION_LEVEL|CURRENT_UPDATE_STATEMENT_SEQUENCE|CURRENT_UPDATE_TRANSACTION|CURRENT_USERGROUP|CURRENT_USER_ID|CURRENT_USER|ENCRYPTION_ROOT_KEYS_EXTRACT_KEYS|ENCRYPTION_ROOT_KEYS_HAS_BACKUP_PASSWORD|ESCAPE_DOUBLE_QUOTES|ESCAPE_SINGLE_QUOTES|EXPRESSION_MACRO|GENERATE_PASSWORD|GET_DELTA_LAKE_TABLE_CHANGES|GET_DELTA_LAKE_TABLE_VERSION|GET_NUM_SERVERS|GET_REMOTE_SOURCE_AI_MODELS|GET_X509_USER_MAPPING_DETAILS|GREATEST|GROUPING_ID|GROUPING|GROUP_SCORE|HASH_MD5|HASH_SHA256|HIERARCHY_ANCESTORS_AGGREGATE|HIERARCHY_ANCESTORS|HIERARCHY_COMPOSITE_ID|HIERARCHY_DESCENDANTS_AGGREGATE|HIERARCHY_DESCENDANTS|HIERARCHY_LEVELED|HIERARCHY_SIBLINGS|HIERARCHY_SPANTREE|HIERARCHY_TEMPORAL|HIERARCHY|IFNULL|INDEXING_ERROR_CODE|INDEXING_ERROR_MESSAGE|INDEXING_STATUS|IS_SQL_INJECTION_SAFE|JSON_QUERY|JSON_TABLE|JSON_VALUE|L2DISTANCE|L2NORMALIZE|L2NORM|LANGUAGE|LEAST|MAP|MEMBER_AT|MIMETYPE|NEWUID|NULLIF|OPENCYPHER_TABLE|PARSE_CERTIFICATES|PARSE_JSON|PARTITION_ALLOCATION|PARTITION_HASH|PLAINTEXT|RDF_GRAPH_FROM_GRAPH_WORKSPACE|RDF_GRAPH_TO_GRAPH_WORKSPACE|RECORD_COMMIT_TIMESTAMP|RECORD_ID|RECORD_LOCK_STATE|RESULT_CACHE_ID|RESULT_CACHE_REFRESH_TIME|ROW_LOCK_WAIT_STATISTICS|SCORE|SERIES_DISAGGREGATE_BIGINT|SERIES_DISAGGREGATE_DATE|SERIES_DISAGGREGATE_DECIMAL|SERIES_DISAGGREGATE_INTEGER|SERIES_DISAGGREGATE_SECONDDATE|SERIES_DISAGGREGATE_SMALLINT|SERIES_DISAGGREGATE_TIMESTAMP|SERIES_DISAGGREGATE_TIME|SERIES_DISAGGREGATE_TINYINT|SERIES_DISAGGREGATE|SERIES_ELEMENT_TO_PERIOD|SERIES_GENERATE_BIGINT|SERIES_GENERATE_DATE|SERIES_GENERATE_DECIMAL|SERIES_GENERATE_INTEGER|SERIES_GENERATE_SECONDDATE|SERIES_GENERATE_SMALLINT|SERIES_GENERATE_TIMESTAMP|SERIES_GENERATE_TIME|SERIES_GENERATE_TINYINT|SERIES_GENERATE|SERIES_PERIOD_TO_ELEMENT|SERIES_ROUND|SESSION_CONTEXT|SESSION_USER|SPARQL_EXECUTE|SPARQL_TABLE|SQLSCRIPT_RUN_TESTS_ON_ORIGINAL_DATA|SQL_TABLE|STATEMENT_EXECUTION_HOST|STATEMENT_EXECUTION_PORT|SUBARRAY|SUBSTR_REGEXPR|SUBVECTOR|SYSUUID|TM_CATEGORIZE_KNN|TM_GET_RELATED_DOCUMENTS|TM_GET_RELATED_TERMS|TM_GET_RELEVANT_DOCUMENTS|TM_GET_RELEVANT_TERMS|TM_GET_SUGGESTED_TERMS|TO_ARRAY|TO_HALF_VECTOR|TO_REAL_VECTOR|TO_VARBINARY|TRIM_ARRAY|UNNEST|VALIDATE_USERGROUP_CONNECT_RESTRICTION_DETAILS|VALIDATE_USERGROUP_CONNECT_RESTRICTION|VECTOR_EMBEDDING|WIDTH_BUCKET|XMLEXTRACTVALUE|XMLEXTRACT)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.spatial.hanasql",
          "match": "(?i)\\b(?:ST_ADDPOINT|ST_ALLOCATEDSIZE|ST_ALPHASHAPEAGGR|ST_ALPHASHAPEAREAAGGR|ST_ALPHASHAPEAREA|ST_ALPHASHAPEEDGE|ST_ALPHASHAPE|ST_AREA|ST_ASBINARY|ST_ASESRIJSON|ST_ASESRISHAPE|ST_ASEWKB|ST_ASEWKT|ST_ASGEOJSON|ST_ASMVTGEOM|ST_ASMVT|ST_ASSVGAGGR|ST_ASSVG|ST_ASTEXT|ST_ASWKB|ST_ASWKT|ST_BOUNDARY|ST_BUFFER|ST_CENTROID|ST_CLOSESTPOINT|ST_CLUSTERCELL|ST_CLUSTERCENTROID|ST_CLUSTERENVELOPE|ST_CLUSTERID|ST_COLLECTAGGR|ST_COLLECT|ST_CONCAVEHULLAGGR|ST_CONCAVEHULL|ST_CONTAINS|ST_CONVEXHULLAGGR|ST_CONVEXHULL|ST_COORDDIM|ST_COVEREDBY|ST_COVERS|ST_CROSSES|ST_CURVETOLINE|ST_DIFFERENCE|ST_DIMENSION|ST_DISJOINT|ST_DISTANCE|ST_DUPLICATES|ST_ENDPOINT|ST_ENVELOPEAGGR|ST_ENVELOPE|ST_EQUALS|ST_EXTERIORRING|ST_FLIPCOORDINATES|ST_FORCE2D|ST_FORCE3DM|ST_FORCE3DZ|ST_FORCE4D|ST_FRECHETDISTANCE|ST_GENERATEPOINTS|ST_GEOHASHBOUNDARY|ST_GEOHASHNEIGHBORS|ST_GEOHASH|ST_GEOMETRYN|ST_GEOMETRYTYPE|ST_GEOMFROMESRISHAPE|ST_GEOMFROMEWKB|ST_GEOMFROMEWKT|ST_GEOMFROMGEOJSON|ST_GEOMFROMTEXT|ST_GEOMFROMWKB|ST_GEOMFROMWKT|ST_HAUSDORFFDISTANCE|ST_HEXAGONGRIDBOUNDINGBOX|ST_HEXAGONGRID|ST_INTERIORRINGN|ST_INTERPOLATEPOINT|ST_INTERSECTIONAGGR|ST_INTERSECTION|ST_INTERSECTSFILTER|ST_INTERSECTSRECTPLANAR|ST_INTERSECTSRECT|ST_INTERSECTS|ST_IS3D|ST_ISCLOSED|ST_ISEMPTY|ST_ISMEASURED|ST_ISRING|ST_ISSIMPLE|ST_ISVALID|ST_LENGTH|ST_LINEHASH|ST_LINEINTERPOLATEPOINT|ST_LINELOCATEPOINT|ST_LINEMERGE|ST_LINESUBSTRING|ST_LOCATEALONG|ST_LOCATEBETWEEN|ST_MAKEENVELOPE|ST_MAKELINEAGGR|ST_MAKELINE|ST_MAKEPOLYGON|ST_MAKEVALID|ST_MINIMUMBOUNDINGCIRCLE|ST_MMAX|ST_MMIN|ST_M|ST_NUMGEOMETRIES|ST_NUMINTERIORRINGS|ST_NUMINTERIORRING|ST_NUMPATCHES|ST_NUMPOINTS|ST_ORDERINGEQUALS|ST_OVERLAPS|ST_PATCHN|ST_PERIMETER|ST_POINTN|ST_POINTONSURFACE|ST_RECTANGLEGRIDBOUNDINGBOX|ST_RECTANGLEGRID|ST_RELATE|ST_REMOVEPOINT|ST_REVERSE|ST_ROTATE|ST_SCALE|ST_SETPOINT|ST_SETSRID|ST_SHORTESTLINE|ST_SIMPLIFY|ST_SNAPTOGRID|ST_SPLIT|ST_SQUAREGRID|ST_SRID|ST_STARTPOINT|ST_SUBDIVIDE|ST_SYMDIFFERENCE|ST_TOUCHES|ST_TRANSFORM|ST_TRANSLATE3D|ST_TRANSLATE|ST_UNIONAGGR|ST_UNION|ST_VORONOICELLAGGR|ST_VORONOICELL|ST_WITHINDISTANCE|ST_WITHIN|ST_XMAX|ST_XMIN|ST_X|ST_YMAX|ST_YMIN|ST_Y|ST_ZMAX|ST_ZMIN|ST_Z)\\b(?=\\s*\\()"
        }
      ]
    },
    "types": {
      "name": "storage.type.hanasql",
      "match": "(?i)\\b(?:ALPHANUM|ARRAY|BIGINT|BINTEXT|BLOB|BOOLEAN|CHAR|CLOB|DATE|DAYDATE|DECIMAL|DEC|DOUBLE|FLOAT|HALF_VECTOR|INTEGER|INT|JSON|LONGDATE|NCHAR|NCLOB|NVARCHAR|REAL_VECTOR|REAL|SECONDDATE|SHORTTEXT|SMALLDECIMAL|SMALLINT|SQLSCRIPT_LOGGING_TABLE_TYPE|SQLSCRIPT_STATEMENT_STATISTICS_TYPE|ST_CIRCULARSTRING|ST_GEOMETRYCOLLECTION|ST_GEOMETRY|ST_LINESTRING|ST_MULTILINESTRING|ST_MULTIPOINT|ST_MULTIPOLYGON|ST_POINTM|ST_POINTZM|ST_POINTZ|ST_POINT|ST_POLYGON|TEXT|TIMESTAMP|TIME|TINYINT|VARBINARY|VARCHAR)\\b"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.hanasql",
          "match": "(?i)\\b(?:FALSE|NULL|TRUE|UNKNOWN)\\b"
        },
        {
          "name": "support.constant.hanasql",
          "match": "(?i)\\b(?:CURRENT_CONNECTION|CURRENT_DATE|CURRENT_SCHEMA|CURRENT_TIMESTAMP|CURRENT_TIME|CURRENT_TRANSACTION_ISOLATION_LEVEL|CURRENT_USER|CURRENT_UTCDATE|CURRENT_UTCTIMESTAMP|CURRENT_UTCTIME|SESSION_USER|SQLSCRIPT|SYSUUID|UTCTIMESTAMP)\\b"
        }
      ]
    },
    "logical-operators": {
      "name": "keyword.operator.logical.hanasql",
      "match": "(?i)\\b(?:AND|ANY|BETWEEN|CONTAINS|EXISTS|IN|IS|LIKE_REGEXPR|LIKE|NOT|OR|SOME)\\b"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.hanasql",
          "match": "(?i)\\b(?:AUTONOMOUS|BEGIN|BREAK|CALL|CASE|CLOSE|CONDITION|CONTINUE|CURSOR|DECLARE|DO|ELSEIF|ELSE|END|EXCEPTION|EXECUTE|EXEC|EXIT|FETCH|FOREACH|FOR|HANDLER|IF|LOOP|OPEN|RESIGNAL|RETURNS|RETURN|SIGNAL|THEN|TRANSACTION|WHEN|WHILE)\\b"
        },
        {
          "name": "keyword.other.dml.hanasql",
          "match": "(?i)\\b(?:ALL|ASC|AS|BOTH|BY|COMMIT|CONNECT|CROSS|CUBE|CURRVAL|DELETE|DESC|DISTINCT|EXCEPT|EXPLAIN|FROM|FULL|GROUP|HAVING|INNER|INSERT|INTERSECT|INTO|JOIN|LATERAL|LEADING|LEFT|LIMIT|LOAD|MERGE|MINUS|NATURAL|NEXTVAL|OCCURRENCE|OFFSET|ON|ORDER|OUTER|OVER|PARTITION|PRIOR|REPLACE|REVERSE|RIGHT|ROLLBACK|ROLLUP|ROWID|SAVEPOINT|SELECT|SET|START|TABLESAMPLE|TOP|TRAILING|TRUNCATE|UNION|UNLOAD|UNSET|UPDATE|UPSERT|USING|VALUES|WHERE|WINDOW|WITH)\\b"
        },
        {
          "name": "keyword.other.ddl.hanasql",
          "match": "(?i)\\b(?:ADD|ALTER|ALWAYS|ANNOTATE|AUTO|BEFORE|CASCADE|CHECK|COLUMN|COMMENT|CONSTRAINT|CREATE|DEFAULT|DEFINER|DROP|FOREIGN|FUNCTION|GENERATED|GLOBAL|GRANT|IDENTITY|INDEX|INOUT|INVOKER|IN|KEY|LANGUAGE|LOCAL|MERGE|MODIFIES|NOWAIT|OUT|PARAMETERS|PRIMARY|PRIORITY|PROCEDURE|READS|REFERENCES|REFRESH|RENAME|REVOKE|ROLE|ROW|SCHEMA|SECURITY|SEQUENCE|SQL|SYNONYM|TABLE|TEMPORARY|TRIGGER|TYPE|UNIQUE|USER|VIEW|VIRTUAL)\\b"
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.hanasql",
      "match": "\\|\\||:=|=>|<>|!=|<=|>=|[-+*/%=<>]"
    },
    "sqlscript-builtins": {
      "patterns": [
        {
          "name": "keyword.control.directive.pragma.hanasql",
          "match": "(?i)#\\[(?:INLINE|NO_INLINE)\\]"
        },
        {
          "name": "storage.type.annotation.pragma.hanasql",
          "match": "(?i)@(?:ANALYZERSUPPRESS|POPSCOPE|PUSHSCOPE|TESTCLASSIFICATION|TESTSETUPCONFIG|TESTSETUPLIBRARY|TESTSETUPTEST|TESTSETUP|TESTTEARDOWNCONFIG|TESTTEARDOWNLIBRARY|TESTTEARDOWNTEST|TESTTEARDOWN|TEST)\\b"
        },
        {
          "match": "\\b([A-Za-z_][\\w]*)(:)([A-Za-z_][\\w]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "variable.other.library.hanasql"
            },
            "2": {
              "name": "punctuation.accessor.hanasql"
            },
            "3": {
              "name": "support.function.library-member.hanasql"
            }
          }
        },
        {
          "match": "\\b([A-Za-z_][\\w]*)(:)(LEVEL_DEBUG|LEVEL_ERROR|LEVEL_FATAL|LEVEL_INFO|LEVEL_WARNING)\\b",
          "captures": {
            "1": {
              "name": "variable.other.library.hanasql"
            },
            "2": {
              "name": "punctuation.accessor.hanasql"
            },
            "3": {
              "name": "support.constant.library-member.hanasql"
            }
          }
        },
        {
          "name": "support.function.sqlscript.hanasql",
          "match": "(?i)\\b(?:CE_[A-Z_]+|APPLY_FILTER|BIND_AS_PARAMETER|BIND_AS_VALUE|DEGREE|EDGES|INDUCED_SUBGRAPH|INVERSE_GRAPH|IN_DEGREE|IN_EDGES|IS_EMPTY|IS_REACHABLE|K_SHORTEST_PATHS|MAP_MERGE|MAP_REDUCE|NEIGHBORS|OUT_DEGREE|OUT_EDGES|RECORD_COUNT|SHORTEST_PATHS_ONE_TO_ALL|SHORTEST_PATH|STRONGLY_CONNECTED_COMPONENTS|SUBGRAPH|VERTICES)\\b(?=\\s*\\()"
        },
        {
          "name": "support.class.library.hanasql",
          "match": "(?i)\\bSQLSCRIPT_[A-Z_]+\\b"
        },
        {
          "name": "support.variable.system.hanasql",
          "match": "(?i)\\b(?:CURRENT_LINE_NUMBER|CURRENT_OBJECT_NAME|CURRENT_OBJECT_SCHEMA|ROWCOUNT|SQL_ERROR_CODE|SQL_ERROR_MESSAGE)\\b"
        },
        {
          "name": "support.constant.hint.hanasql",
          "match": "(?i)\\b(?:INLINE|NO_INLINE|NO_VECTOR_INDEX|ROUTE_TO|VECTOR_INDEX)\\b"
        },
        {
          "name": "keyword.control.sqlscript.hanasql",
          "match": "(?i)\\b(?:BFS|CONSTANT|DETERMINISTIC|DFS|ENCRYPTION|EXECUTION|LIBRARY|PARALLEL|PRIVATE|PRUNE|PUBLIC|SEQUENTIAL|SQLEXCEPTION|SQLWARNING|TEST|TRAVERSE|VISIT)\\b"
        }
      ]
    },
    "statements": {
      "patterns": [
        {
          "name": "keyword.other.statement.hanasql",
          "match": "(?i)\\bALTER\\s+SYSTEM\\b(?:\\s+(?:ABSTRACT|ADD|ALL|ALTER|APPLICATION|APPLY|ASYNCHRONOUS|AUDIT|CACHE|CAPTURE|CHECK|CLEAR|COLUMN|CONFIGURATION|CONSISTENCY|CONTENT|CREATE|DATA|DISABLE|ENABLE|ENCRYPTION|ENTRY|FILE|HISTORY|INIFILE|JOIN|KERNEL|LOAD|LOB|LOCATION|LOG|MONITORING|PERFTRACE|PLACEMENT|PLAN|PROFILER|PROFILE|RECLAIM|RECOMPILE|RECONFIGURE|REFRESH|REMOVE|RESET|RESULT|RUNTIMEDUMP|SAVEPOINT|SAVE|SECTIONS|SERVICE|SPACE|SQL|START|STATISTICS|STOP|SYSTEM|TABLE|THREADS|TIMEZONE|TRACEPROFILE|TRACES|VIEW|WAITGRAPH))*"
        },
        {
          "name": "keyword.other.statement.hanasql",
